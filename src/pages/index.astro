---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { dateHTML, url, lines } from "../lib/util";

const poems = (await getCollection("poems")).sort((a, b) => +b.data.date - +a.data.date);
---
<Base title="行間">
  <div class="view">
    <section class="mast">
      <h1 class="site">行間</h1>
      <p class="haiku" aria-label="荒地無人鋤，風送來的都長著，該枯便枯了">
        <span>荒地無人鋤</span>
        <span>風送來的都長著</span>
        <span>該枯便枯了</span>
      </p>
      <span class="seal mast-seal">行<br />間</span>
    </section>

    {poems.length > 0 ? (
      <nav class="toc" aria-label="詩作目錄">
        {poems.map((p) => (
          <a href={url(p.id)}>
            <span class="t">{p.data.title}</span>
            <span class="d" set:html={dateHTML(p.data.date)} />
            <span class="f">{lines(p.body).find((l) => l)}</span>
          </a>
        ))}
      </nav>
    ) : (
      <p class="empty">詩還在路上</p>
    )}

    <p class="colophon">共收<span class="tcy">{poems.length}</span>首<br />內文　思源宋體<br />標題　霞鶩文楷</p>
  </div>
</Base>
